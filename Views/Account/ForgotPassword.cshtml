@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center py-lg-4">
    <div class="col-md-8 col-lg-5">
        <div class="cr-panel cr-glow p-4">
            <div class="cr-label"><span>Password recovery</span></div>
            <h1 class="cr-title mb-1">Forgot your password?</h1>
            <p class="cr-sub mb-4">Enter the email or username of your account. We'll email you a link to choose a new password.</p>

            <form asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="mb-4">
                    <label asp-for="Login" class="form-label"></label>
                    <input asp-for="Login" class="form-control" autocomplete="email" placeholder="you@example.com" maxlength="254" autofocus />
                    <span asp-validation-for="Login" class="small"></span>
                </div>
                <button type="submit" class="cr-btn green w-100">Email me a reset link</button>
            </form>

            <p class="mt-4 mb-0 small">Remembered it? <a asp-action="Login">Back to log in</a>.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
