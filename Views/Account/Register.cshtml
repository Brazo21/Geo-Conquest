@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="row justify-content-center py-lg-4">
    <div class="col-md-10 col-lg-7">
        <div class="cr-panel cr-glow p-4">
            <div class="cr-label"><span>Enlistment form</span></div>
            <h1 class="cr-title mb-1">Enlist as a Commander</h1>
            <p class="cr-sub mb-4">Playing needs a free account. Watching does not.</p>

            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autocomplete="username" placeholder="e.g. brazo21" maxlength="20" autofocus />
                        <div class="cr-sub mt-1">3–20 letters, numbers or _ · used to log in</div>
                        <span asp-validation-for="Username" class="small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="DisplayName" class="form-label"></label>
                        <input asp-for="DisplayName" class="form-control" placeholder="e.g. Commander Brazo" maxlength="30" />
                        <div class="cr-sub mt-1">Shown on the board and leaderboard</div>
                        <span asp-validation-for="DisplayName" class="small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" maxlength="254" />
                        <span asp-validation-for="Email" class="small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="8+ characters, a letter and a number" maxlength="100" />
                        <span asp-validation-for="Password" class="small"></span>
                        <div class="cr-sub mt-1">At least 8 characters, with a letter and a number.</div>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Type the same password again" maxlength="100" />
                        <span asp-validation-for="ConfirmPassword" class="small"></span>
                    </div>
                    <div class="col-12">
                        <div class="cr-consent">
                            <div class="cr-label mb-2"><span>POPIA consent · Protection of Personal Information Act 4 of 2013</span></div>
                            <p class="small mb-2">
                                To run your account we keep your <strong>username</strong>, <strong>email</strong>, <strong>commander name</strong>
                                and a <strong>hashed</strong> password, plus your games. We use them only to log you in, reset your password,
                                and show your games and leaderboard results. Your email is never shown to other players or shared for marketing.
                                You can see or delete everything we hold at any time.
                            </p>
                            <p class="small mb-3"><a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">Read the full privacy notice ↗</a></p>
                            <div class="form-check">
                                <input asp-for="PopiaConsent" class="form-check-input" />
                                <label asp-for="PopiaConsent" class="form-check-label small">I have read the privacy notice and consent to GeoConquest processing my personal information for these purposes.</label>
                            </div>
                            <span asp-validation-for="PopiaConsent" class="small"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="cr-btn green w-100 mt-4">Create account</button>
            </form>

            <p class="mt-4 mb-0 small">Already enlisted? <a asp-action="Login">Log in</a>.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
