@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
    bool valid = ViewData["LinkValid"] as bool? ?? false;
}

<div class="row justify-content-center py-lg-4">
    <div class="col-md-8 col-lg-5">
        <div class="cr-panel cr-glow p-4">
            <div class="cr-label"><span>Password recovery</span></div>
            @if (!valid)
            {
                <h1 class="cr-title mb-2">This link doesn't work</h1>
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <p>Reset links work once and expire after 30 minutes. Asking again sends a fresh one and cancels the old one.</p>
                <a asp-action="ForgotPassword" class="cr-btn green mt-2">Send a new link</a>
            }
            else
            {
                <h1 class="cr-title mb-1">Choose a new password</h1>
                <p class="cr-sub mb-4">Afterwards you'll be signed out on every device and can log in with the new password.</p>

                <form asp-action="ResetPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                    <input type="hidden" asp-for="Uid" />
                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="8+ characters, a letter and a number" maxlength="100" autofocus />
                        <span asp-validation-for="Password" class="small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Type it again" maxlength="100" />
                        <span asp-validation-for="ConfirmPassword" class="small"></span>
                    </div>
                    <button type="submit" class="cr-btn green w-100">Save new password</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
