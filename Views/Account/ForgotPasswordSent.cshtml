@{
    ViewData["Title"] = "Check your email";
    var devLink = TempData["DevResetLink"] as string;
}

<div class="row justify-content-center py-lg-4">
    <div class="col-md-8 col-lg-6">
        <div class="cr-panel cr-glow p-4">
            <div class="cr-label"><span>Password recovery</span></div>
            <h1 class="cr-title mb-2">Check your email</h1>
            <p>If that email or username belongs to an active account, a reset link is on its way. It works <strong class="cr-amber">once</strong> and expires in <strong class="cr-amber">30 minutes</strong>.</p>
            <p class="cr-sub">No email after a few minutes? Check your spam folder, or ask again.</p>

            @if (devLink is not null)
            {
                <div class="cr-consent mt-3">
                    <div class="cr-label mb-1"><span>Development mode only</span></div>
                    <p class="small mb-2">Email isn't set up on this machine, so here is the link that would have been emailed. This box never appears on the deployed site.</p>
                    <a class="small text-break" href="@devLink">@devLink</a>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-action="Login" class="cr-btn green">Back to log in</a>
                <a asp-action="ForgotPassword" class="cr-btn">Send another link</a>
            </div>
        </div>
    </div>
</div>
