@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string scope = Context.Request.Query["scope"].ToString();
    bool loggedIn = User.Identity?.IsAuthenticated == true;

    // Which menu item is lit up.
    string active =
        controller == "Games" && action == "Index" && (scope == "live" || (!loggedIn && scope == "")) ? "live" :
        controller == "Games" && (action == "Index" || action == "Play") ? "home" :
        controller == "Games" && action == "New" ? "new" :
        controller == "Home" && action == "HowToPlay" ? "how" :
        controller == "Stats" && action == "Leaderboard" ? "board" :
        controller == "Stats" && action == "Analytics" ? "analytics" :
        controller == "Home" && action == "Settings" ? "settings" :
        controller == "Home" && action == "App" ? "app" :
        controller == "Admin" ? "admin" :
        controller == "Account" && action == "MyData" ? "me" :
        controller == "Account" && action == "Security" ? "security" :
        controller == "Account" ? "account" : "";

    string Lit(string key) => active == key ? "active" : "";
    bool isAdmin = User.IsInRole(UserAccount.AdminRole);
    bool statsActive = active is "board" or "analytics";
    bool meActive = active is "settings" or "admin" or "me" or "app" or "security";
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <script nonce="@Context.CspNonce()">
        // Apply the saved light/dark choice before the page paints (no flash).
        try { const t = localStorage.getItem('geoconquest.theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch { }
        // Same for brightness, scanlines and text size from the Settings page.
        try {
            const s = JSON.parse(localStorage.getItem('geoconquest.settings') || '{}'), r = document.documentElement;
            const b = Number(s.brightness);
            if (b >= 60 && b <= 140 && b !== 100) { r.style.setProperty('--cr-brightness', String(b / 100)); r.dataset.bright = '1'; }
            if (s.scanlines === false) r.dataset.scanlines = 'off';
            if (['sm', 'md', 'lg', 'xl'].includes(s.textSize)) r.dataset.text = s.textSize;
        } catch { }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · GeoConquest Command Room</title>
    @* Tab icons: PNG/ICO for every browser, SVG for those that support it. *@
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="icon" href="~/icons/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="~/icons/icon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    @* Installable app (PWA): Android/desktop read the manifest, iPhone reads the apple-* tags. *@
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#0e0c08" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="GeoConquest" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=VT323&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/command-room.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="cr-topbar">
        <nav class="container-fluid px-3 px-lg-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <a class="cr-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index" aria-label="GeoConquest home">
                <partial name="_Logo" />
                <span>GeoConquest<span class="d-none d-sm-inline"> · Command Room</span></span>
            </a>

            <button class="navbar-toggler cr-toggler d-lg-none px-2 py-1" type="button" data-bs-toggle="collapse"
                    data-bs-target="#cr-menu" aria-controls="cr-menu" aria-expanded="false" aria-label="Toggle menu">MENU</button>

            <div id="cr-menu" class="collapse d-lg-flex w-100 w-lg-auto">
                <ul class="cr-nav justify-content-lg-end pt-2 pt-lg-0">
                    @if (loggedIn)
                    {
                        <li><a class="@Lit("home")" asp-controller="Games" asp-action="Index" asp-route-scope="mine">Home</a></li>
                    }
                    <li><a class="@Lit("live")" asp-controller="Games" asp-action="Index" asp-route-scope="live">Live Games</a></li>
                    @if (loggedIn)
                    {
                        <li class="dropdown">
                            <button type="button" class="dropdown-toggle @(statsActive ? "active" : "")" data-bs-toggle="dropdown" aria-expanded="false">Stats</button>
                            <ul class="dropdown-menu cr-menu">
                                <li><a class="dropdown-item @Lit("board")" asp-controller="Stats" asp-action="Leaderboard">Leaderboard</a></li>
                                <li><a class="dropdown-item @Lit("analytics")" asp-controller="Stats" asp-action="Analytics">My analytics</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li><a class="@Lit("board")" asp-controller="Stats" asp-action="Leaderboard">Leaderboard</a></li>
                    }
                    <li><a class="@Lit("how")" asp-controller="Home" asp-action="HowToPlay">How To Play</a></li>
                    @if (loggedIn)
                    {
                        <li><a class="cr-signup @Lit("new")" asp-controller="Games" asp-action="New">+ New Game</a></li>
                        <li class="dropdown">
                            <button type="button" class="dropdown-toggle cr-who-btn @(meActive ? "active" : "")" data-bs-toggle="dropdown" aria-expanded="false">
                                Cmdr @User.Identity!.Name@(isAdmin ? " ★" : "")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end cr-menu">
                                @if (isAdmin)
                                {
                                    <li><a class="dropdown-item @Lit("admin")" asp-controller="Admin" asp-action="Index">★ Admin panel</a></li>
                                }
                                <li><a class="dropdown-item @Lit("settings")" asp-controller="Home" asp-action="Settings">⚙ Settings</a></li>
                                <li><a class="dropdown-item @Lit("security")" asp-controller="Account" asp-action="Security">🔒 Account security</a></li>
                                <li><a class="dropdown-item @Lit("me")" asp-controller="Account" asp-action="MyData">Your data</a></li>
                                <li><a class="dropdown-item @Lit("app")" asp-controller="Home" asp-action="App">📲 Get the app</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">Log out</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li><a class="@Lit("settings")" asp-controller="Home" asp-action="Settings" aria-label="Settings">⚙</a></li>
                        <li><a class="@(action == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login">Log In</a></li>
                        <li><a class="cr-signup @(action == "Register" ? "active" : "")" asp-controller="Account" asp-action="Register">Sign Up</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main role="main" class="container-fluid px-3 px-lg-4 py-3">
        @if (TempData["Success"] is string success)
        {
            <div class="cr-alert ok" role="status">
                <span>✔ @success</span>
                <button type="button" data-dismiss-alert aria-label="Dismiss">×</button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="cr-alert err" role="alert">
                <span>⚠ @error</span>
                <button type="button" data-dismiss-alert aria-label="Dismiss">×</button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="cr-footer">
        <div class="container-fluid px-3 px-lg-4 d-flex flex-wrap justify-content-between gap-2">
            <span>© 2026 GeoConquest</span>
            <span class="d-flex gap-3">
                <a asp-controller="Home" asp-action="App" data-app-link>📲 Get the app</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/geo-settings.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/geo-audio.js" asp-append-version="true"></script>
    <script src="~/js/dice.js" asp-append-version="true"></script>
    <script src="~/js/general.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
