@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center py-5">
    <div class="col-lg-7">
        <div class="cr-panel cr-red-edge p-4 p-md-5 text-center">
            <div class="cr-label justify-content-center"><span class="cr-red">Signal lost · error @Model.StatusCode</span></div>
            <div class="cr-digits cr-red mb-2" style="font-size:5rem">@Model.StatusCode</div>
            <h1 class="cr-title mb-3">@Model.Title</h1>
            <p class="mb-4">@Model.Message</p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a class="cr-btn green" asp-controller="Home" asp-action="Index">Back to base</a>
                <a class="cr-btn" asp-controller="Games" asp-action="Index" asp-route-scope="live">Live games</a>
                <button type="button" class="cr-btn ghost" data-go-back>← Go back</button>
            </div>
            @if (Model.ShowRequestId)
            {
                <p class="cr-sub mt-4 mb-0" style="font-size:.7rem">Reference: @Model.RequestId</p>
            }
        </div>
    </div>
</div>
