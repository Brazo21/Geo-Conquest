@{
    ViewData["Title"] = "Privacy";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="cr-panel">
            <div class="cr-label"><span>Privacy</span></div>
            <h1 class="cr-title mb-3">Privacy policy</h1>
            <ul class="ps-3" style="line-height:1.9">
                <li>We store your username, email, commander name and a <strong class="cr-amber">hashed</strong> password (never the password itself).</li>
                <li>Games are public to anyone with the link, so spectators can watch. Only you can play your games.</li>
                <li>Battle details (not your personal details) are sent to an AI service to write live commentary.</li>
                <li>One sign-in cookie keeps you logged in. No tracking or advertising cookies.</li>
            </ul>
        </div>
    </div>
</div>
